# The database (products, items, account, API tokens). Back this folder up.
DOCKET_DATA_DIR=./data
DOCKET_PORT=8200
# Only this machine can reach Docket by default: use Tailscale Serve or a
# reverse proxy. Set your LAN or Tailscale address (or 0.0.0.0 for every
# network) to open it to other devices directly.
DOCKET_BIND=127.0.0.1
# Proxies allowed to tell Docket the real client address (X-Forwarded-For),
# for sign-in rate limits and the devices list. Loopback is always trusted.
# DOCKET_TRUSTED_PROXIES=172.16.0.0/12
DOCKET_TRUSTED_PROXIES=
# Names you open Docket at, besides IP addresses, localhost and Tailscale
# (*.ts.net) names, e.g. docket.example.com or *.example.com. Other names are
# refused, so a web page can't reach Docket by pointing its own name at it.
DOCKET_HOSTS=
# Days deleted items stay in the trash.
DOCKET_TRASH_DAYS=30
# Your time zone, for "today", "overdue" and "due this week".
TZ=UTC
PUID=1000
PGID=1000
